{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "zaiqoM",
  "version": "1.0.0",
  "identifier": "com.nexq.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "zaiqoM",
        "width": 900,
        "height": 650,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "zaiqoM",
        "width": 500,
        "height": 700,
        "minWidth": 400,
        "minHeight": 480,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "x": 50,
        "y": 50
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "zaiqoM",
      "menuOnLeftClick": false
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
